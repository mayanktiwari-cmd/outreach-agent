# Required
GROQ_API_KEY=gsk_your_key_here

# Optional - defaults shown
LLM_MODEL=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///./outreach.db
SEND_MODE=dry_run
# SEND_MODE=smtp  # Only set this when you truly want to send real emails

# SMTP settings (only needed if SEND_MODE=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app_password_here

# IMAP settings (optional, for reply tracking)
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=app_password_here

# Your sender identity
SENDER_EMAIL=you@university.edu
SENDER_NAME=Your Name

# Follow-up settings
FOLLOWUP_INTERVAL_DAYS=7
MAX_FOLLOWUPS=2

# Grounding check thresholds
JUDGE_CONFIDENCE_THRESHOLD=0.60
JUDGE_RETRY_THRESHOLD=0.40
